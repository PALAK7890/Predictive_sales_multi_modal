cat > .gitignore << EOF
# Python
__pycache__/
*.py[cod]
*.so

# Virtual Environment
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# VS Code
.vscode/

# Models
models/trained/*.pkl
models/trained/*.joblib

# Logs
*.log

# Dataset
data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Reports
reports/figures/*
!reports/figures/.gitkeep

reports/tables/*
!reports/tables/.gitkeep
EOF